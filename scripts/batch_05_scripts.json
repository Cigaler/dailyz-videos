    "topic": "How Noise-Canceling Headphones Actually Work",
    "publish_date": "06_07",
    "phrases": [
      {"text": "Your headphones fight sound with sound.", "keywords": ["fight sound"], "pause_after": 0.5},
      {"text": "Here's the weird science behind it.", "keywords": ["weird science"], "pause_after": 0.4},
      {"text": "Every sound is a wave.", "keywords": ["wave"], "pause_after": 0.4},
      {"text": "Noise-canceling mics hear the noise.", "keywords": ["mics", "noise"], "pause_after": 0.4},
      {"text": "Then the headphones generate the opposite.", "keywords": ["opposite"], "pause_after": 0.5},
      {"text": "Called an anti-wave.", "keywords": ["anti-wave"], "pause_after": 0.5},
      {"text": "The two waves cancel each other.", "keywords": ["cancel"], "pause_after": 0.5},
      {"text": "Silence — in real time.", "keywords": ["Silence"], "pause_after": 0.5},
      {"text": "All of this happens in microseconds.", "keywords": ["microseconds"], "pause_after": 0.4},
      {"text": "Faster than you can hear it.", "keywords": ["Faster"], "pause_after": 0.4},
      {"text": "Physics working in your ears.", "keywords": ["Physics"], "pause_after": 0.4},
      {"text": "It's called destructive interference.", "keywords": ["destructive interference"], "pause_after": 0.5},
      {"text": "Known since the 1930s.", "keywords": ["1930s"], "pause_after": 0.4},
      {"text": "Follow for more mind-blowing science.", "keywords": ["Follow", "mind-blowing"], "pause_after": 0.4}
    ]
